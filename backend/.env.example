# Default: use an existing GitHub Copilot subscription.
AI_PROVIDER=copilot
COPILOT_MODEL=auto

# Leave unset to use the locally signed-in Copilot identity. For a deployed
# multi-user app, pass each user's OAuth token instead of committing a token.
# COPILOT_GITHUB_TOKEN=
# COPILOT_HOME=

# Optional direct OpenAI API fallback.
# OPENAI_API_KEY=
# OPENAI_MODEL=<model-id>

# Optional local Ollama fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

DATABASE_URL=sqlite:///./ai_novel_app.db
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

MAX_CHAPTERS_PER_STORY=50
DEFAULT_CHAPTER_LENGTH=2000
GENERATION_TIMEOUT=300
NOVEL_COMPLEXITY=standard
API_V1_PREFIX=/api/v1
